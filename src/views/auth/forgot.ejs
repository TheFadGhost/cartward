<%- include('/partials/head') %>
<div class="auth-card">
  <h1>Reset your password</h1>
  <p>Tell us the email on the account and we'll send a reset link. The link works once and
  expires after 30 minutes.</p>
  <form method="post" action="/forgot-password" class="stack" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" autocomplete="email" required
             value="<%= values.email || '' %>" aria-invalid="<%= errors.email ? 'true' : 'false' %>">
      <span class="field-error" id="email-error"><%= errors.email || '' %></span>
    </div>
    <button type="submit" class="button">Send reset link</button>
  </form>
</div>
<%- include('/partials/footer') %>
