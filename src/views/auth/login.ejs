<%- include('/partials/head') %>
<div class="auth-card">
  <h1>Sign in</h1>
  <% if (errors.form) { %><div class="form-errors" role="alert"><%= errors.form %></div><% } %>
  <form method="post" action="/login" class="stack" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" autocomplete="email" required
             value="<%= values.email || '' %>" aria-invalid="<%= errors.email ? 'true' : 'false' %>"
             <%= errors.email ? `aria-describedby="email-error"` : '' %>>
      <span class="field-error" id="email-error"><%= errors.email || '' %></span>
    </div>
    <div class="field">
      <label for="password">Password</label>
      <input type="password" id="password" name="password" autocomplete="current-password" required
             aria-invalid="<%= errors.password ? 'true' : 'false' %>"
             <%= errors.password ? `aria-describedby="password-error"` : '' %>>
      <span class="field-error" id="password-error"><%= errors.password || '' %></span>
    </div>
    <button type="submit" class="button">Sign in</button>
  </form>
  <p class="switch">
    New here? <a href="/register">Create an account</a> ·
    <a href="/forgot-password">Forgot your password?</a>
  </p>
</div>
<%- include('/partials/footer') %>
