<%- include('/partials/head') %>
<div class="auth-card">
  <% if (verified) { %>
    <h1>Email verified</h1>
    <p>Your email address is confirmed. You're all set.</p>
    <p><a href="/account">Go to your account</a> or <a href="/">keep browsing</a>.</p>
  <% } else { %>
    <h1>Link expired</h1>
    <p>That verification link is invalid or has expired. Sign in and request a new one.</p>
    <form method="post" action="/verify-email/resend" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" autocomplete="email" required>
      </div>
      <button type="submit" class="button">Resend verification link</button>
    </form>
  <% } %>
</div>
<%- include('/partials/footer') %>
