<%- include('/partials/head') %>
<div class="page-pad">
  <h1>Your account</h1>
  <p>Signed in as <strong><%= user.email %></strong>.</p>
  <% if (!user.emailVerified) { %>
    <div class="flash flash-warn" role="status">
      Your email isn't verified yet. Check your inbox for the verification link.
    </div>
  <% } %>

  <section aria-labelledby="security-heading">
    <h2 id="security-heading">Security</h2>
    <p>Manage two-factor authentication, review active sessions and revoke access.</p>
    <p><a class="button button-secondary" href="/account/security">Security settings</a></p>
    <form method="post" action="/logout">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="linklike">Sign out</button>
    </form>
  </section>

  <section aria-labelledby="orders-heading">
    <h2 id="orders-heading">Orders</h2>
    <p><a href="/orders">View your order history</a> or <a href="/">keep browsing the shop.</a></p>
  </section>
</div>
<%- include('/partials/footer') %>
