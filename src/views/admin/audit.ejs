<%- include('/partials/admin-head') %>

<h1>Audit log</h1>
<table class="data">
  <thead><tr><th scope="col">When</th><th scope="col">Actor</th><th scope="col">Action</th><th scope="col">Entity</th><th scope="col">Detail</th></tr></thead>
  <tbody>
    <% rows.forEach((a) => { %>
      <tr>
        <td><%= new Date(a.created_at).toLocaleString('en-US') %></td>
        <td><%= a.actor_type %><%= a.actor_id ? ' ' + a.actor_id.slice(0, 8) : '' %></td>
        <td><strong><%= a.action %></strong></td>
        <td><%= a.entity_type || '—' %> <%= a.entity_id ? a.entity_id.slice(0, 8) : '' %></td>
        <td class="wrap"><code style="font-size:11px;"><%= a.after_json || a.before_json || '' %></code></td>
      </tr>
    <% }) %>
    <% if (rows.length === 0) { %><tr><td colspan="5">Nothing audited yet.</td></tr><% } %>
  </tbody>
</table>

<%- include('/partials/admin-foot') %>
