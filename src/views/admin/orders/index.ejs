<%- include('/partials/admin-head') %>

<h1>Orders</h1>
<form method="get" action="/admin/orders" class="admin-toolbar">
  <input type="search" name="q" value="<%= q %>" placeholder="Number, email, address… ( / )" aria-label="Search orders">
  <select name="status" aria-label="Filter by status">
    <option value="">Any status</option>
    <% ['pending','paid','fulfilled','shipped','cancelled','refunded'].forEach((s) => { %>
      <option value="<%= s %>" <%= status === s ? 'selected' : '' %>><%= s %></option>
    <% }) %>
  </select>
  <button type="submit" class="button button-secondary">Filter</button>
  <a class="button button-secondary" href="/admin/orders.csv<%= status ? '?status=' + status : '' %>"
     download>Export CSV</a>
  <span class="result-count"><%= rows.length %> shown</span>
</form>

<table class="data">
  <thead><tr>
    <th scope="col" aria-sort="<%= ariaSort('number') || 'none' %>"><a href="?q=<%= encodeURIComponent(q) %>&status=<%= status || '' %>&sort=number&direction=<%= nextDirection('number') %>" aria-label="Sort by order number">Order <%= arrowFor('number') %></a></th>
    <th scope="col" aria-sort="<%= ariaSort('placed') || 'none' %>"><a href="?q=<%= encodeURIComponent(q) %>&status=<%= status || '' %>&sort=placed&direction=<%= nextDirection('placed') %>" aria-label="Sort by placement date">Placed <%= arrowFor('placed') %></a></th>
    <th scope="col">Customer</th>
    <th scope="col">Status</th>
    <th scope="col" class="num" aria-sort="<%= ariaSort('total') || 'none' %>"><a href="?q=<%= encodeURIComponent(q) %>&status=<%= status || '' %>&sort=total&direction=<%= nextDirection('total') %>" aria-label="Sort by order total">Total <%= arrowFor('total') %></a></th>
  </tr></thead>
  <tbody>
    <% rows.forEach((o) => { %>
      <tr>
        <td><a href="/admin/orders/<%= o.id %>"><%= o.number %></a></td>
        <td><%= new Date(o.placed_at).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></td>
        <td><%= o.user_email || o.guest_email || '—' %></td>
        <td><span class="pill pill-<%= o.status %>"><%= o.status %></span></td>
        <td class="num"><%= formatMoney(o.total_cents) %></td>
      </tr>
    <% }) %>
    <% if (rows.length === 0) { %>
      <tr><td colspan="5">
        No orders match<% if (q) { %> “<%= q %>”<% } %><% if (status) { %> with status “<%= status %>”<% } %>.
        <a href="/admin/orders">Clear filters</a>
      </td></tr>
    <% } %>
  </tbody>
</table>

<%- include('/partials/admin-foot') %>
