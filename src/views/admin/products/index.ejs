<%- include('/partials/admin-head') %>

<h1>Products</h1>
<form method="get" action="/admin/products" class="admin-toolbar">
  <input type="search" name="q" value="<%= q %>" placeholder="Search products ( / )" aria-label="Search products">
  <select name="status" aria-label="Filter by status">
    <option value="">Any status</option>
    <option value="active" <%= statusFilter === 'active' ? 'selected' : '' %>>Active</option>
    <option value="draft" <%= statusFilter === 'draft' ? 'selected' : '' %>>Draft</option>
    <option value="archived" <%= statusFilter === 'archived' ? 'selected' : '' %>>Archived</option>
  </select>
  <button type="submit" class="button button-secondary">Filter</button>
  <a class="button" href="/admin/products/new">New product</a>
  <span class="result-count"><%= rows.length %> shown</span>
</form>

<form method="post" action="/admin/products/bulk" data-bulk-form>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="admin-toolbar">
    <span id="bulk-count" role="status">0 selected</span>
    <button type="submit" name="action" value="archive" class="button button-secondary" disabled>Bulk archive</button>
    <button type="submit" name="action" value="activate" class="button button-secondary" disabled>Bulk activate</button>
  </div>
  <table class="data" data-bulk-table>
    <thead><tr>
      <th scope="col"><input type="checkbox" data-bulk-all aria-label="Select all products"></th>
      <th scope="col"></th>
      <th scope="col">Name</th>
      <th scope="col">Brand</th>
      <th scope="col">Category</th>
      <th scope="col">Status</th>
      <th scope="col" class="num">Variants</th>
      <th scope="col" class="num">Available</th>
    </tr></thead>
    <tbody>
      <% rows.forEach((p) => { %>
        <tr>
          <td><input type="checkbox" name="ids" value="<%= p.id %>" data-bulk-checkbox aria-label="Select <%= p.name %>"></td>
          <td><% if (p.image) { %><img src="/media/products/<%= p.image %>" alt="" width="34" height="34" class="thumb-img"><% } %></td>
          <td class="wrap"><a href="/admin/products/<%= p.id %>"><%= p.name %></a></td>
          <td><%= p.brand_name || '—' %></td>
          <td><%= p.category_name || '—' %></td>
          <td><span class="pill pill-<%= p.status %>"><%= p.status %></span></td>
          <td class="num"><%= p.variant_count %></td>
          <td class="num"><%= p.available %><% if (p.available <= 3) { %> <span class="pill pill-low">low</span><% } %></td>
        </tr>
      <% }) %>
      <% if (rows.length === 0) { %><tr><td colspan="8">No products match<% if (q) { %> “<%= q %>”<% } %>. <a href="/admin/products">Clear filters</a> or create the first one.</td></tr><% } %>
    </tbody>
  </table>
</form>

<%- include('/partials/admin-foot') %>
