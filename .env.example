# Cartward environment configuration.
# Copy to `.env` (gitignored) if you want to override defaults.
# NEVER put real secrets, keys or credentials in this file or in `.env`.

# HTTP port the server listens on
PORT=3000

# Public base URL used in emails and absolute links
APP_BASE_URL=http://localhost:3000

# Environment: development | production (affects cookie Secure flag and error verbosity)
NODE_ENV=development

# Paths (relative to project root). All are gitignored.
DATABASE_PATH=data/cartward.db
UPLOAD_DIR=data/uploads
EMAIL_DIR=data/emails

# Session secret. If unset, a strong random secret is generated on first run
# and stored at data/.session-secret (gitignored). Never commit one.
SESSION_SECRET=
